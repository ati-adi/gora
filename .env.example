# Gora environment (01 §14 + 02 §F + 03 R7 + 07). Placeholders only — never commit real values.
# Copy to .env for local runs (`npm run dev` / `npm start` load it via --env-file-if-exists=.env).

# ── Core
NODE_ENV=development                 # development | test | production
GORA_MODE=polling                    # webhook | polling
PORT=8080
PUBLIC_URL=https://gora.example.com  # must equal the Mini App domain registered in BotFather
DATA_DIR=./data                      # gora.db lives here
KEYS_DB_PATH=./keys/keys.db          # MUST be a different volume in production (not under DATA_DIR)
BACKUP_DIR=./backups                 # nightly gora.db + keys.db backups, 7 days (not under DATA_DIR in production)
LOG_LEVEL=info
MINIAPP_FRAME_ANCESTORS=https://web.telegram.org https://*.telegram.org

# ── Telegram
TELEGRAM_BOT_TOKEN=                  # empty → only `npm test` / `npm run sim` work
TELEGRAM_WEBHOOK_SECRET=             # 1-256 chars [A-Za-z0-9_-]; required for GORA_MODE=webhook
TELEGRAM_API_ROOT=https://api.telegram.org
TELEGRAM_TEST_ENV=false              # true → /bot<token>/test/<method>
ADMIN_TG_IDS=                        # comma-separated, alerts only

# ── Secrets (base64, 32 bytes each; generate with: node -e "console.log(crypto.randomBytes(32).toString('base64'))")
# Required whenever TELEGRAM_BOT_TOKEN is set (and always in production). Only when no bot token is configured
# (tests, `npm run sim`) do empty values fall back to fixed, publicly derivable development keys.
GORA_KEK=                            # wraps DEKs; never stored on the data volume
GORA_CALLBACK_KEY=                   # HMAC for callback_data
GORA_HASH_KEY=                       # keyed HMAC for hashes, fingerprints, ledger chain
ALLOW_INSECURE_DEV_KEYS=false        # 1 → accept the insecure dev keys even with a bot token (throwaway test bots only; never in production)

# ── LLM provider (03 R2): auto → anthropic if ANTHROPIC_API_KEY, else groq if GROQ_API_KEY, else demo (non-production only)
LLM_PROVIDER=auto                    # auto | groq | anthropic
LLM_MAX_PROMPT_TOKENS=               # optional override of the profile's prompt cap

# ── Groq (02 §F) — also serves TTS, the prompt guard, the LLM sentinel and vision whenever the key is set (STT: see STT_PROVIDER)
GROQ_API_KEY=
GROQ_TIER=free                       # free | dev — picks the groq-free / groq-dev profile
GROQ_MODEL_MAIN=openai/gpt-oss-120b
GROQ_MODEL_FAST=openai/gpt-oss-20b
GROQ_MODEL_VISION=qwen/qwen3.8-27b
GROQ_MODEL_SENTINEL=openai/gpt-oss-safeguard-20b
GROQ_MODEL_GUARD=meta-llama/llama-prompt-guard-2-86m
GROQ_MODEL_STT=whisper-large-v3-turbo
GROQ_MODEL_TTS=canopylabs/orpheus-v1-english
GROQ_TTS_VOICE=hannah                # hannah | diana | autumn | austin | daniel | troy

# ── Anthropic (optional; plugs in later)
ANTHROPIC_API_KEY=                   # empty → Groq (if keyed) or DemoTransport (non-production only)
ANTHROPIC_MODEL=claude-opus-5        # ANTHROPIC_MODEL_MAIN (02 §F) takes precedence when set
ANTHROPIC_MODEL_MAIN=
ANTHROPIC_SIDE_MODEL=claude-opus-5
ANTHROPIC_BASE_URL=
PRICING_OVERRIDES_JSON=

# ── Feature flags
FEATURE_SERVER_COMPACTION=true
FEATURE_CLEAR_AT=false
FEATURE_CACHE_DIAGNOSIS=false
FEATURE_WEB_FETCH_URL_SOURCES=true
FEATURE_BUSINESS=true
FEATURE_BUSINESS_RICH=false
FEATURE_GUEST=true
FEATURE_GROUPS=true
FEATURE_MISSIONS=true
FEATURE_MAKE_FILE=true
FEATURE_VOICE_REPLIES=true           # global switch for /voice replies (03 R4); users still opt in
FEATURE_BROWSER=true                 # spec 07 §A: browse_task + the browser toolkit (needs BROWSER_PROVIDER=playwright)
FEATURE_GROUP_PARTICIPANT=true       # spec 07 §C: read the whole group and chime in (needs BotFather group privacy OFF); false = mention-only

# ── Providers (anything paid or OAuth sits behind an interface; fakes are the default)
INTEGRATIONS_PROVIDER=fake           # fake | composio | none   (fake is refused in production)
COMPOSIO_API_KEY=                    # spec 07 B5: a Composio Platform PROJECT key (ak_…); consumer keys (ck_…) get 401 code 801
COMPOSIO_AUTH_CONFIG_GCAL=           # optional: pin the Composio-managed Google Calendar auth config (ac_…); empty → found/created by name
COMPOSIO_AUTH_CONFIG_GMAIL=          # optional: same for Gmail (created lazily the first time a Gmail tool is needed)
STT_PROVIDER=auto                    # auto (groq if GROQ_API_KEY, else openai if OPENAI_API_KEY, else none) | groq | openai | none | fake (tests only; refused with a real bot token)
STT_MODEL=                           # default: GROQ_MODEL_STT, or gpt-transcribe with STT_PROVIDER=openai
OPENAI_API_KEY=
WEATHER_PROVIDER=openmeteo           # fake | openmeteo | metno   (Open-Meteo free tier is non-commercial)
FX_PROVIDER=erapi                    # fake | erapi
GEO_PROVIDER=live                    # fake | live (Open-Meteo geocoding + Photon + tz-lookup)
HTTP_USER_AGENT=GoraBot/1.0 (+https://gora.example.com/bot)

# ── Friend mode (spec 05)
EMBEDDINGS_PROVIDER=local            # local (Xenova/multilingual-e5-small on CPU, downloaded once, ~144 MB) | fake | none (keyword search only)
EMBEDDINGS_MODEL=Xenova/multilingual-e5-small
EMBEDDINGS_CACHE_DIR=                # default: <DATA_DIR>/models
PROACTIVE_TAU=0.3                    # send threshold of the learned proactive policy (0–1); "less" ×1.5, "more" ×0.7 per user

# ── Browser agent (spec 07 §A) — headless Chromium via Playwright, installed once: npx playwright install chromium
BROWSER_PROVIDER=playwright          # playwright | none (nothing is launched at boot; the first browse task launches Chromium)
BROWSER_HEADLESS=true
BROWSER_SANDBOX=true                 # Chromium's OS sandbox; false ONLY inside a container that cannot provide it (then isolate the container)
BROWSER_EXECUTABLE_PATH=             # optional Chromium/Chrome binary (default: Playwright's cache, ~/Library/Caches/ms-playwright)

# ── Live smokes: LIVE=1 npm run smoke:groq · LIVE=1 npm run smoke:composio [-- --after-connect --account ca_… | --write]
LIVE=
