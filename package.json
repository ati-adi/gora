{
  "name": "gora",
  "version": "0.1.0",
  "private": true,
  "description": "Gora: a Telegram-native personal AI agent",
  "type": "module",
  "engines": {
    "node": ">=26.8.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/main.ts",
    "dev": "node --env-file-if-exists=.env --watch src/main.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p webapp/tsconfig.json",
    "test": "vitest run --project unit",
    "test:e2e": "vitest run --project e2e --passWithNoTests",
    "test:e2e:strict": "vitest run --project e2e",
    "build:webapp": "vite build --config webapp/vite.config.ts",
    "sim": "node scripts/sim.ts",
    "smoke:groq": "node --env-file-if-exists=.env scripts/smoke-groq.ts",
    "smoke:composio": "node --env-file-if-exists=.env scripts/smoke-composio.ts",
    "admin": "node --env-file-if-exists=.env scripts/admin.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.128.0",
    "@grammyjs/auto-retry": "2.0.2",
    "@hono/node-server": "2.1.1",
    "@huggingface/transformers": "4.3.0",
    "@photostructure/tz-lookup": "11.7.0",
    "chrono-node": "2.10.1",
    "croner": "10.0.1",
    "decode-named-character-reference": "1.3.0",
    "grammy": "1.46.0",
    "groq-sdk": "1.6.0",
    "hono": "4.13.9",
    "mdast-util-from-markdown": "2.0.3",
    "mdast-util-gfm": "3.1.0",
    "micromark-extension-gfm": "3.0.0",
    "opusscript": "0.1.1",
    "pino": "10.3.1",
    "playwright": "1.63.0",
    "telegram-md-entities": "0.6.0",
    "unpdf": "1.8.1",
    "zod": "4.6.5"
  },
  "optionalDependencies": {
    "@composio/core": "0.21.0"
  },
  "devDependencies": {
    "@types/mdast": "4.0.4",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/telegram-web-app": "10.1.0",
    "@vitejs/plugin-react": "6.1.1",
    "mdast-util-to-string": "4.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
